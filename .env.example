# Copy to .env (git-ignored). Never commit real keys.

# --- LLM chat (OpenAI-compatible endpoint; swap provider by changing these 3 lines) ---
# Default: Gemini (one key can be used for chat and embeddings)
LL_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LL_AI_API_KEY=YOUR_GEMINI_API_KEY
LL_AI_CHAT_MODEL=gemini-3.1-flash-lite

# Alternative: change the three chat settings together for another
# OpenAI-compatible provider and an available model.

# --- Embeddings: Gemini API (needed even when chat uses NVIDIA). Free key: https://aistudio.google.com ---
LL_EMBED_API_KEY=YOUR_GEMINI_API_KEY
LL_EMBED_MODEL=gemini-embedding-001
LL_EMBED_DIMENSIONS=768

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://loanlens:loanlens@localhost:5432/loanlens
LL_JWT_SECRET=dev-only-change-me

# --- Backend / frontend ---
LL_SERVER_PORT=8080
VITE_API_BASE_URL=
VITE_USE_MOCKS=false
